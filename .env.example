# Kopieer dit bestand naar .env.local (lokaal) of vul deze waarden in bij Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API (of "Data API")
SUPABASE_URL=https://jouwproject.supabase.co
# De "service_role"-sleutel (geheim!). Komt nooit in de browser, alleen op de server.
SUPABASE_SERVICE_ROLE_KEY=

# Het wachtwoord dat je team gebruikt om in te loggen.
TEAM_PASSWORD=

# Een lange willekeurige tekst (minstens 32 tekens) om de login-cookie te ondertekenen.
# Maak er een met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
